<%- include('../partials/head') %>
<%- include('../partials/header') %>

<main class="wrap product-detail">
  <a href="/products" class="back-link">&larr; Back to shop</a>

  <div class="product-detail-grid">
    <div class="product-detail-emoji"><%= product.emoji %></div>
    <div>
      <h1><%= product.name %></h1>
      <p class="product-category"><%= product.category %></p>
      <p class="product-price-big">$<%= (product.price_cents / 100).toFixed(2) %></p>
      <p><%= product.description %></p>
      <p class="muted">In stock: <%= product.stock %></p>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
